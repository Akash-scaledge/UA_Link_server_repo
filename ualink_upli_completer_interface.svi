
`ifndef UALINK_UPLI_COMPLETER_INTERFACE_SVI
`define UALINK_UPLI_COMPLETER_INTERFACE_SVI

interface ualink_upli_completer_interface (input bit upli_clk, input bit upli_resetn);

  // Interface Control Signals
  logic                                                   comp_clk_req;
  logic                                                   orig_clk_ack;
  logic                                                   orig_clk_req;
  logic                                                   comp_clk_ack;

  // Request Channel Signals

  logic                                                   req_valid;
  logic [`UPLI_MAX_REQ_PORT_ID_WIDTH -1:0]                req_port_id;
  logic [`UPLI_MAX_REQ_ASI_WIDTH -1:0]                    req_asi;
  logic [`UPLI_MAX_REQ_AUTH_TAG_WIDTH -1:0]               req_auth_tag;
  logic [`UPLI_MAX_REQ_SRC_PHYS_ACC_ID_WIDTH -1:0]        req_src_phys_acc_id;
  logic [`UPLI_MAX_REQ_DST_PHYS_ACC_ID_WIDTH -1:0]        req_dst_phys_acc_id;
  logic [`UPLI_MAX_REQ_TAG_WIDTH -1:0]                    req_tag;
  logic [`UPLI_MAX_REQ_NUM_BEATS_WIDTH -1:0]              req_num_beats;
  logic [`UPLI_MAX_REQ_ADDR_WIDTH -1:0]                   req_addr;
  logic [`UPLI_MAX_REQ_CMD_WIDTH -1:0]                    req_cmd;
  logic [`UPLI_MAX_REQ_LEN_WIDTH -1:0]                    req_len;
  logic [`UPLI_MAX_REQ_ATTR_WIDTH -1:0]                   req_attr;
  logic [`UPLI_MAX_REQ_META_DATA_WIDTH -1:0]              req_meta_data;
  logic [`UPLI_MAX_REQ_VC_WIDTH -1:0]                     req_vc;
  logic                                                   req_pool;
  logic [`UPLI_MAX_REQ_CREDIT_INIT_DONE_WIDTH -1:0]       req_credit_init_done;
  logic [`UPLI_MAX_REQ_CREDIT_VLD_WIDTH -1:0]             req_credit_vld;
  logic [`UPLI_MAX_REQ_CREDIT_POOL_WIDTH -1:0]            req_credit_pool;
  logic [`UPLI_MAX_REQ_CREDIT_PORT0_VC_WIDTH -1:0]        req_credit_port0_vc;
  logic [`UPLI_MAX_REQ_CREDIT_PORT1_VC_WIDTH -1:0]        req_credit_port1_vc;
  logic [`UPLI_MAX_REQ_CREDIT_PORT2_VC_WIDTH -1:0]        req_credit_port2_vc;
  logic [`UPLI_MAX_REQ_CREDIT_PORT3_VC_WIDTH -1:0]        req_credit_port3_vc;
  logic [`UPLI_MAX_REQ_CREDIT_PORT0_NUM_WIDTH -1:0]       req_credit_port0_num;
  logic [`UPLI_MAX_REQ_CREDIT_PORT1_NUM_WIDTH -1:0]       req_credit_port1_num;
  logic [`UPLI_MAX_REQ_CREDIT_PORT2_NUM_WIDTH -1:0]       req_credit_port2_num;
  logic [`UPLI_MAX_REQ_CREDIT_PORT3_NUM_WIDTH -1:0]       req_credit_port3_num;
  logic                                                   req_vld_parity;
  logic                                                   req_addr_parity;
  logic                                                   req_parity;
  logic                                                   req_credit_vld_parity;
  logic                                                   req_credit_parity;

  // completer Data Channel Signals
  logic                                                   orig_data_vld;
  logic [`UPLI_MAX_ORIG_DATA_PORT_ID_WIDTH -1:0]          orig_data_port_id;
  logic [`UPLI_MAX_ORIG_DATA_WIDTH -1:0]                  orig_data;
  logic [(`UPLI_MAX_ORIG_DATA_WIDTH/8) -1:0]              orig_data_byte_en;
  logic [`UPLI_MAX_ORIG_DATA_OFFSET_WIDTH -1:0]           orig_data_offset;
  logic                                                   orig_data_last;
  logic                                                   orig_data_error;
  logic [`UPLI_MAX_ORIG_DATA_VC_WIDTH -1:0]               orig_data_vc;
  logic                                                   orig_data_pool;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_INIT_DONE_WIDTH -1:0] orig_data_credit_init_done;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_VLD_WIDTH -1:0]       orig_data_credit_vld;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_POOL_WIDTH -1:0]      orig_data_credit_pool;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT0_VC_WIDTH -1:0]  orig_data_credit_port0_vc;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT1_VC_WIDTH -1:0]  orig_data_credit_port1_vc;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT2_VC_WIDTH -1:0]  orig_data_credit_port2_vc;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT3_VC_WIDTH -1:0]  orig_data_credit_port3_vc;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT0_NUM_WIDTH -1:0] orig_data_credit_port0_num;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT1_NUM_WIDTH -1:0] orig_data_credit_port1_num;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT2_NUM_WIDTH -1:0] orig_data_credit_port2_num;
  logic [`UPLI_MAX_ORIG_DATA_CREDIT_PORT3_NUM_WIDTH -1:0] orig_data_credit_port3_num;
  logic                                                   orig_data_vld_parity;
  logic                                                   orig_data_parity;
  logic                                                   orig_data_byte_en_parity;
  logic                                                   orig_data_fields_parity;
  logic                                                   orig_data_credit_vld_parity;
  logic                                                   orig_data_credit_parity;

  // Write Response Channel Signals

  logic                                                   wr_rsp_vld;
  logic [`UPLI_MAX_WR_RSP_PORT_ID_WIDTH -1:0]             wr_rsp_port_id;
  logic [`UPLI_MAX_WR_RSP_AUTH_TAG_WIDTH -1:0]            wr_rsp_auth_tag;
  logic [`UPLI_MAX_WR_RSP_SRC_PHYS_ACC_ID_WIDTH -1:0]     wr_rsp_src_phys_acc_id;
  logic [`UPLI_MAX_WR_RSP_DST_PHYS_ACC_ID_WIDTH -1:0]     wr_rsp_dst_phys_acc_id;
  logic [`UPLI_MAX_WR_RSP_TAG_WIDTH -1:0]                 wr_rsp_tag;
  logic [`UPLI_MAX_WR_RSP_STATUS_WIDTH -1:0]              wr_rsp_status;
  logic [`UPLI_MAX_WR_RSP_VC_WIDTH -1:0]                  wr_rsp_vc;
  logic                                                   wr_rsp_pool;
  logic [`UPLI_MAX_WR_RSP_CREDIT_INIT_DONE_WIDTH -1:0]    wr_rsp_credit_init_done;
  logic [`UPLI_MAX_WR_RSP_CREDIT_VLD_WIDTH -1:0]          wr_rsp_credit_vld;
  logic [`UPLI_MAX_WR_RSP_CREDIT_POOL_WIDTH -1:0]         wr_rsp_credit_pool;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT0_VC_WIDTH -1:0]     wr_rsp_credit_port0_vc;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT1_VC_WIDTH -1:0]     wr_rsp_credit_port1_vc;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT2_VC_WIDTH -1:0]     wr_rsp_credit_port2_vc;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT3_VC_WIDTH -1:0]     wr_rsp_credit_port3_vc;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT0_NUM_WIDTH -1:0]    wr_rsp_credit_port0_num;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT1_NUM_WIDTH -1:0]    wr_rsp_credit_port1_num;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT2_NUM_WIDTH -1:0]    wr_rsp_credit_port2_num;
  logic [`UPLI_MAX_WR_RSP_CREDIT_PORT3_NUM_WIDTH -1:0]    wr_rsp_credit_port3_num;
  logic                                                   wr_rsp_vld_parity;
  logic                                                   wr_rsp_parity;
  logic                                                   wr_rsp_credit_vld_parity;
  logic                                                   wr_rsp_credit_parity;

  // Read Response and Data channel signals

  logic                                                   rd_rsp_vld;
  logic [`UPLI_MAX_RD_RSP_PORT_ID_WIDTH -1:0]             rd_rsp_port_id;
  logic [`UPLI_MAX_RD_RSP_AUTH_TAG_WIDTH -1:0]            rd_rsp_auth_tag;
  logic [`UPLI_MAX_RD_RSP_SRC_PHYS_ACC_ID_WIDTH -1:0]     rd_rsp_src_phys_acc_id;
  logic [`UPLI_MAX_RD_RSP_DST_PHYS_ACC_ID_WIDTH -1:0]     rd_rsp_dst_phys_acc_id;
  logic [`UPLI_MAX_RD_RSP_TAG_WIDTH -1:0]                 rd_rsp_tag;
  logic [`UPLI_MAX_RD_RSP_NUM_BEATS_WIDTH -1:0]           rd_rsp_num_beats;
  logic [`UPLI_MAX_RD_RSP_DATA_WIDTH -1:0]                rd_rsp_data;
  logic [`UPLI_MAX_RD_RSP_STATUS_WIDTH -1:0]              rd_rsp_status;
  logic [`UPLI_MAX_RD_RSP_OFFSET_WIDTH -1:0]              rd_rsp_offset;
  logic                                                   rd_rsp_last;
  logic                                                   rd_rsp_data_error;
  logic [`UPLI_MAX_RD_RSP_VC_WIDTH -1:0]                  rd_rsp_vc;
  logic                                                   rd_rsp_pool;
  logic [`UPLI_MAX_RD_RSP_CREDIT_INIT_DONE_WIDTH -1:0]    rd_rsp_credit_init_done;
  logic [`UPLI_MAX_RD_RSP_CREDIT_VLD_WIDTH -1:0]          rd_rsp_credit_vld;
  logic [`UPLI_MAX_RD_RSP_CREDIT_POOL_WIDTH -1:0]         rd_rsp_credit_pool;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT0_VC_WIDTH -1:0]     rd_rsp_credit_port0_vc;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT1_VC_WIDTH -1:0]     rd_rsp_credit_port1_vc;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT2_VC_WIDTH -1:0]     rd_rsp_credit_port2_vc;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT3_VC_WIDTH -1:0]     rd_rsp_credit_port3_vc;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT0_NUM_WIDTH -1:0]    rd_rsp_credit_port0_num;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT1_NUM_WIDTH -1:0]    rd_rsp_credit_port1_num;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT2_NUM_WIDTH -1:0]    rd_rsp_credit_port2_num;
  logic [`UPLI_MAX_RD_RSP_CREDIT_PORT3_NUM_WIDTH -1:0]    rd_rsp_credit_port3_num;
  logic                                                   rd_rsp_vld_parity;
  logic                                                   rd_rsp_data_parity;
  logic                                                   rd_rsp_parity;
  logic                                                   rd_rsp_credit_vld_parity;
  logic                                                   rd_rsp_credit_parity;

  clocking upli_completer_drv_cb @(posedge upli_clk);
    default input #`UPLI_INPUT_SKEW output #`UPLI_OUTPUT_SKEW;
    output comp_clk_req;
    input  orig_clk_ack;
    output comp_clk_ack;
    input  orig_clk_req;

    input  req_valid;
    input  req_port_id;
    input  req_asi;
    input  req_auth_tag;
    input  req_src_phys_acc_id;
    input  req_dst_phys_acc_id;
    input  req_tag;
    input  req_num_beats;
    input  req_addr;
    input  req_cmd;
    input  req_len;
    input  req_attr;
    input  req_meta_data;
    input  req_vc;
    input  req_pool;
    output req_credit_init_done;
    output req_credit_vld;
    output req_credit_pool;
    output req_credit_port0_vc;
    output req_credit_port1_vc;
    output req_credit_port2_vc;
    output req_credit_port3_vc;
    output req_credit_port0_num;
    output req_credit_port1_num;
    output req_credit_port2_num;
    output req_credit_port3_num;
    input  req_vld_parity;
    input  req_addr_parity;
    input  req_parity;
    output req_credit_vld_parity;
    output req_credit_parity;

    input  orig_data_vld;
    input  orig_data_port_id;
    input  orig_data;
    input  orig_data_byte_en;
    input  orig_data_offset;
    input  orig_data_last;
    input  orig_data_error;
    input  orig_data_vc;
    input  orig_data_pool;
    output orig_data_credit_init_done;
    output orig_data_credit_vld;
    output orig_data_credit_pool;
    output orig_data_credit_port0_vc;
    output orig_data_credit_port1_vc;
    output orig_data_credit_port2_vc;
    output orig_data_credit_port3_vc;
    output orig_data_credit_port0_num;
    output orig_data_credit_port1_num;
    output orig_data_credit_port2_num;
    output orig_data_credit_port3_num;
    input  orig_data_vld_parity;
    input  orig_data_parity;
    input  orig_data_byte_en_parity;
    input  orig_data_fields_parity;
    output orig_data_credit_vld_parity;
    output orig_data_credit_parity;

    output wr_rsp_vld;
    output wr_rsp_port_id;
    output wr_rsp_auth_tag;
    output wr_rsp_src_phys_acc_id;
    output wr_rsp_dst_phys_acc_id;
    output wr_rsp_tag;
    output wr_rsp_status;
    output wr_rsp_vc;
    output wr_rsp_pool;
    input  wr_rsp_credit_init_done;
    input  wr_rsp_credit_vld;
    input  wr_rsp_credit_pool;
    input  wr_rsp_credit_port0_vc;
    input  wr_rsp_credit_port1_vc;
    input  wr_rsp_credit_port2_vc;
    input  wr_rsp_credit_port3_vc;
    input  wr_rsp_credit_port0_num;
    input  wr_rsp_credit_port1_num;
    input  wr_rsp_credit_port2_num;
    input  wr_rsp_credit_port3_num;
    output wr_rsp_vld_parity;
    output wr_rsp_parity;
    input  wr_rsp_credit_vld_parity;
    input  wr_rsp_credit_parity;

    output rd_rsp_vld;
    output rd_rsp_port_id;
    output rd_rsp_auth_tag;
    output rd_rsp_src_phys_acc_id;
    output rd_rsp_dst_phys_acc_id;
    output rd_rsp_tag;
    output rd_rsp_num_beats;
    output rd_rsp_data;
    output rd_rsp_status;
    output rd_rsp_offset;
    output rd_rsp_last;
    output rd_rsp_data_error;
    output rd_rsp_vc;
    output rd_rsp_pool;
    input  rd_rsp_credit_init_done;
    input  rd_rsp_credit_vld;
    input  rd_rsp_credit_pool;
    input  rd_rsp_credit_port0_vc;
    input  rd_rsp_credit_port1_vc;
    input  rd_rsp_credit_port2_vc;
    input  rd_rsp_credit_port3_vc;
    input  rd_rsp_credit_port0_num;
    input  rd_rsp_credit_port1_num;
    input  rd_rsp_credit_port2_num;
    input  rd_rsp_credit_port3_num;
    output rd_rsp_vld_parity;
    output rd_rsp_data_parity;
    output rd_rsp_parity;
    input  rd_rsp_credit_vld_parity;
    input  rd_rsp_credit_parity;

  endclocking: upli_completer_drv_cb

  clocking upli_completer_mon_cb @(posedge upli_clk);
    default input #`UPLI_INPUT_SKEW output #`UPLI_OUTPUT_SKEW;
    input  comp_clk_req;
    input  orig_clk_ack;
    input  orig_clk_req;
    input  comp_clk_ack;

    input req_valid;
    input req_port_id;
    input req_asi;
    input req_auth_tag;
    input req_src_phys_acc_id;
    input req_dst_phys_acc_id;
    input req_tag;
    input req_num_beats;
    input req_addr;
    input req_cmd;
    input req_len;
    input req_attr;
    input req_meta_data;
    input req_vc;
    input req_pool;
    input req_credit_init_done;
    input req_credit_vld;
    input req_credit_pool;
    input req_credit_port0_vc;
    input req_credit_port1_vc;
    input req_credit_port2_vc;
    input req_credit_port3_vc;
    input req_credit_port0_num;
    input req_credit_port1_num;
    input req_credit_port2_num;
    input req_credit_port3_num;
    input req_vld_parity;
    input req_addr_parity;
    input req_parity;
    input req_credit_vld_parity;
    input req_credit_parity;

    input orig_data_vld;
    input orig_data_port_id;
    input orig_data;
    input orig_data_byte_en;
    input orig_data_offset;
    input orig_data_last;
    input orig_data_error;
    input orig_data_vc;
    input orig_data_pool;
    input orig_data_credit_init_done;
    input orig_data_credit_vld;
    input orig_data_credit_pool;
    input orig_data_credit_port0_vc;
    input orig_data_credit_port1_vc;
    input orig_data_credit_port2_vc;
    input orig_data_credit_port3_vc;
    input orig_data_credit_port0_num;
    input orig_data_credit_port1_num;
    input orig_data_credit_port2_num;
    input orig_data_credit_port3_num;
    input orig_data_vld_parity;
    input orig_data_parity;
    input orig_data_byte_en_parity;
    input orig_data_fields_parity;
    input orig_data_credit_vld_parity;
    input orig_data_credit_parity;

    input wr_rsp_vld;
    input wr_rsp_port_id;
    input wr_rsp_auth_tag;
    input wr_rsp_src_phys_acc_id;
    input wr_rsp_dst_phys_acc_id;
    input wr_rsp_tag;
    input wr_rsp_status;
    input wr_rsp_vc;
    input wr_rsp_pool;
    input wr_rsp_credit_init_done;
    input wr_rsp_credit_vld;
    input wr_rsp_credit_pool;
    input wr_rsp_credit_port0_vc;
    input wr_rsp_credit_port1_vc;
    input wr_rsp_credit_port2_vc;
    input wr_rsp_credit_port3_vc;
    input wr_rsp_credit_port0_num;
    input wr_rsp_credit_port1_num;
    input wr_rsp_credit_port2_num;
    input wr_rsp_credit_port3_num;
    input wr_rsp_vld_parity;
    input wr_rsp_parity;
    input wr_rsp_credit_vld_parity;
    input wr_rsp_credit_parity;

    input rd_rsp_vld;
    input rd_rsp_port_id;
    input rd_rsp_auth_tag;
    input rd_rsp_src_phys_acc_id;
    input rd_rsp_dst_phys_acc_id;
    input rd_rsp_tag;
    input rd_rsp_num_beats;
    input rd_rsp_data;
    input rd_rsp_status;
    input rd_rsp_offset;
    input rd_rsp_last;
    input rd_rsp_data_error;
    input rd_rsp_vc;
    input rd_rsp_pool;
    input rd_rsp_credit_init_done;
    input rd_rsp_credit_vld;
    input rd_rsp_credit_pool;
    input rd_rsp_credit_port0_vc;
    input rd_rsp_credit_port1_vc;
    input rd_rsp_credit_port2_vc;
    input rd_rsp_credit_port3_vc;
    input rd_rsp_credit_port0_num;
    input rd_rsp_credit_port1_num;
    input rd_rsp_credit_port2_num;
    input rd_rsp_credit_port3_num;
    input rd_rsp_vld_parity;
    input rd_rsp_data_parity;
    input rd_rsp_parity;
    input rd_rsp_credit_vld_parity;
    input rd_rsp_credit_parity;

  endclocking: upli_completer_mon_cb

  modport upli_comp_drv_mp(input upli_clk, input upli_resetn, clocking upli_completer_drv_cb );
  modport upli_comp_mon_mp(input upli_clk, input upli_resetn, clocking upli_completer_mon_cb );

endinterface: ualink_upli_completer_interface

`endif // UALINK_UPLI_COMPLETER_INTERFACE_SVI

